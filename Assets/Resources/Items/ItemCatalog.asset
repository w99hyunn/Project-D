  m_Script: {fileID: 11500000, guid: e448dd26d930acf409fe4b2bc592deb1, type: 3}
  m_Name: ItemCatalog
  m_EditorClassIdentifier: Assembly-CSharp::DoHwa.World.ItemCatalog
  items:
  - title: "\uCCAD\uC625 \uB2E8\uAC80"
    category: "\uC7A5\uBE44"
    description: "\uD478\uB978 \uC625\uC73C\uB85C \uC190\uC7A1\uC774\uB97C \uAC10\uC2FC \uC9E7\uC740 \uAC80.\n\uAC00\uBCCD\uACE0 \uADE0\uD615\uC774 \uC88B\uC544 \uC232\uAE38\uC758 \uB3D9\uBC18\uC790\uAC00 \uB41C\uB2E4."
    icon: {fileID: 21300000, guid: 5f9a46769d314a9499b31c9a44db6024, type: 2}
    equipmentPart: 0
  - title: "\uCCA0 \uACE1\uAD2D\uC774"
    category: "\uC7A5\uBE44"
    description: "\uB2E8\uB2E8\uD55C \uAD11\uB9E5\uC744 \uCE90\uB294 \uD0D0\uD5D8 \uB3C4\uAD6C.\n\uB098\uBB34 \uC190\uC7A1\uC774\uC5D0 \uC624\uB79C \uC190\uAE38\uC774 \uB0A8\uC544 \uC788\uB2E4."
    icon: {fileID: 21300000, guid: 495b8a324c8b32a4b86f827e06addcc8, type: 2}
    equipmentPart: 0
  - title: "\uC798 \uC775\uC740 \uBCF5\uC22D\uC544"
    category: "\uC18C\uBAA8\uD488"
    description: "\uB3C4\uD654\uB9BC\uC758 \uD587\uC0B4\uC744 \uBA38\uAE08\uC740 \uB2EC\uCF64\uD55C \uBCF5\uC22D\uC544.\n\n\uD3EC\uB9CC\uAC10 +20   /   \uCCB4\uB825 +5"
    icon: {fileID: 21300000, guid: 787bd395e37d09d4db5c40264336613f, type: 2}
    equipmentPart: -1
  - title: "\uD68C\uBCF5\uC57D"
    category: "\uC18C\uBAA8\uD488"
    description: "\uC232\uC758 \uC57D\uCD08\uB97C \uC815\uC131\uAECF \uB2EC\uC778 \uBD89\uC740 \uBB3C\uC57D.\n\n\uCCB4\uB825 +35"
    icon: {fileID: 21300000, guid: a2ec8e5ad4097d04c91362d4287e03de, type: 2}
    equipmentPart: -1
  - title: "\uB2E8\uB2E8\uD55C \uBAA9\uC7AC"
    category: "\uC7AC\uB8CC"
    description: "\uB3C4\uAD6C\uC640 \uAC00\uAD6C\uB97C \uB9CC\uB4DC\uB294 \uB370 \uC4F0\uB294 \uBAA9\uC7AC."
    icon: {fileID: 21300000, guid: 555f8cc5dbd17214187c5be9d5e5f176, type: 2}
    equipmentPart: -1
  - title: "\uCCA0\uAD11\uC11D"
    category: "\uC7AC\uB8CC"
    description: "\uD478\uB978 \uBE5B\uC774 \uB3C4\uB294 \uB2E8\uB2E8\uD55C \uAD11\uC11D.\n\uC81C\uB828 \uC7AC\uB8CC\uB85C \uC0AC\uC6A9\uD55C\uB2E4."
    icon: {fileID: 21300000, guid: 27fda675624f76e4d9585f90a543aaea, type: 2}
    equipmentPart: -1
  - title: "\uC2F1\uC2F1\uD55C \uC57D\uCD08"
    category: "\uC7AC\uB8CC"
    description: "\uAC15\uAC00 \uADF8\uB298\uC5D0\uC11C \uC790\uB77C\uB294 \uD5A5\uAE0B\uD55C \uC57D\uCD08.\n\uD68C\uBCF5\uC57D\uC744 \uB9CC\uB4DC\uB294 \uC7AC\uB8CC\uB2E4."
    icon: {fileID: 21300000, guid: 4dc5c9c937f5c584db4afa05c1def10c, type: 2}
    equipmentPart: -1
  - title: "\uACC4\uACE1 \uBB3C\uACE0\uAE30"
    category: "\uC18C\uBAA8\uD488"
    description: "\uB9D1\uC740 \uACC4\uACE1\uC5D0\uC11C \uC7A1\uC740 \uC791\uC740 \uBB3C\uACE0\uAE30.\n\n\uD3EC\uB9CC\uAC10 +20   /   \uCCB4\uB825 +5"
    icon: {fileID: 21300000, guid: 0b00e822a1289a84094f789073fc273c, type: 2}
    equipmentPart: -1
  - title: "\uC544\uB9C8\uD3EC"
    category: "\uC7AC\uB8CC"
    description: "\uC637\uAC10\uACFC \uC0DD\uD65C \uB3C4\uAD6C\uC5D0 \uC4F0\uB294 \uBD80\uB4DC\uB7EC\uC6B4 \uCC9C."
    icon: {fileID: 21300000, guid: 9cc1d31dd52dd60469cd711616c8390b, type: 2}
    equipmentPart: -1
  - title: "\uC528\uC557 \uC8FC\uBA38\uB2C8"
    category: "\uC7AC\uB8CC"
    description: "\uC0C8\uB85C\uC6B4 \uD130\uC804\uC5D0 \uC2EC\uC744 \uC528\uC557\uC774 \uB4E0 \uC8FC\uBA38\uB2C8."
    icon: {fileID: 21300000, guid: 0d66b0859a653a74da6e6171f56cc70c, type: 2}
    equipmentPart: -1
  - title: "\uCCAD\uC625 \uB178\uB9AC\uAC1C"
    category: "\uC7A5\uBE44"
    description: "\uACE0\uC6B4 \uB9E4\uB4ED\uACFC \uD478\uB978 \uC625\uC744 \uC5EE\uC740 \uC7A5\uC2E0\uAD6C.\n\uC232\uC758 \uD3C9\uC628\uC744 \uB2F4\uACE0 \uC788\uB2E4."
    icon: {fileID: 21300000, guid: 31590703e567bdd44888c8c3c624df7d, type: 2}
    equipmentPart: 5
  - title: "\uAE08\uC18D \uC8FC\uAD34"
    category: "\uC7AC\uB8CC"
    description: "\uB2E8\uB2E8\uD558\uAC8C \uC81C\uB828\uD55C \uC791\uC740 \uC8FC\uAD34.\n\uB3C4\uAD6C \uC81C\uC791\uC5D0 \uC4F0\uC774\uB294 \uC7AC\uB8CC\uB2E4."
    icon: {fileID: 21300000, guid: bb473b90c1db1fa4eaedec0bfe407c7d, type: 2}
    equipmentPart: -1
